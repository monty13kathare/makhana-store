# Copy to .env (or set in your host's environment).

# Backend base URL, including /api/v1. Read at request time: change it and
# restart the server (no rebuild needed). Browser calls go to this site's
# /api/v1, which is proxied here by src/app/api/v1/[...path]/route.ts.
API_URL=http://localhost:4000/api/v1

# Same value as REVALIDATE_SECRET in makhana-backend/.env (on-demand cache refresh).
REVALIDATE_SECRET=
